# ── Google Maps ───────────────────────────────────────────────────────────────
# Required. Google Cloud console → APIs & Services → Credentials → Create API key.
# Enable these APIs on the same project:
#   - Maps JavaScript API   (basemap + deck.gl overlay)
#   - Street View Static API + Street View tiles (the embedded pano panel)
# Restrict the key by HTTP referrer to your deployed domain and localhost.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Required for vector rendering. Google Cloud console → Google Maps Platform →
# Map Management → Create Map ID (type: JavaScript, rendering: Vector).
# Attach a dark map style to it so the basemap matches the dashboard chrome;
# google.maps.Map `styles` is ignored whenever a mapId is present.
# Falls back to DEMO_MAP_ID (watermarked, rate-limited) if unset.
VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here
