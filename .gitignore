# ── Data (immutable raw snapshots; not committed) ──────────────────────────────
data/raw/**/*
!data/raw/**/.gitkeep
!data/raw/README.md
data/proc/**/*
!data/proc/.gitkeep
data/model/**/*
!data/model/.gitkeep

# ── Reports (keep only canonical outputs; exclude working milestone docs) ──────
reports/milestone*.md
reports/DEVIATIONS.md
reports/*.png
reports/figures/
reports/nn_sequence_experiment.md
results/nn_sequence_bakeoff_results.json
# Keep these:
!reports/verified_canonical_numbers.json
!reports/milestone_final.md

# ── Internal working docs (not for public repo) ────────────────────────────────
docs/PROJECT_STATE.md
docs/ROADMAP.md
docs/README.md


# ── Claude / tooling working files ─────────────────────────────────────────────
.claude/
CLAUDE.md
graphify-out/
*.obsidian/

# ── Debug / probe scratch work (not part of the documented pipeline) ──────────
data/probe/

# ── Cache and temp ────────────────────────────────────────────────────────────
cache/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.env

# ── Conda / venv ──────────────────────────────────────────────────────────────
.venv/
env/

