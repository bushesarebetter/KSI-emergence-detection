{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "DATA_BASE_URL": "https://ksi-emergence.onrender.com/data" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "DATA_BASE_URL": "https://ksi-emergence.onrender.com/data" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "DATA_BASE_URL": "https://ksi-emergence.onrender.com/data" }
    }
  },
  "submit": { "production": {} }
}
