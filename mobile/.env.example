# Copied into app.json -> extra at build time by app.config.js.
# Create these in the SAME Google Cloud project as the web dashboard key, but as
# SEPARATE keys: Android keys are restricted by package name + SHA-1 signing
# certificate, iOS keys by bundle identifier. A browser-restricted key will not
# work on either platform.
#
# Google Cloud console -> APIs & Services -> Credentials -> Create API key
# Enable: "Maps SDK for Android" and "Maps SDK for iOS".
GOOGLE_MAPS_ANDROID_API_KEY=your_android_key_here
GOOGLE_MAPS_IOS_API_KEY=your_ios_key_here

# Where the app pulls intersections.geojson / districts.json from. Point this at
# the deployed dashboard so the app picks up new model exports without an app
# store release.
DATA_BASE_URL=https://ksi-emergence.onrender.com/data
